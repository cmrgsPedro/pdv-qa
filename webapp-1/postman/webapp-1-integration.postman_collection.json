    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const nome = pm.collectionVariables.get('film_name');",
          "const id = pm.collectionVariables.get('film_id');",
          "if (nome) pm.variables.set('film_name', nome);",
          "if (id) pm.variables.set('film_id', id);",
          "const metodo = pm.request.method;",
          "const recurso = pm.request.url.path[2];",
          "const exigeFilme = metodo === 'PUT' || metodo === 'DELETE' ||",
          "    (metodo === 'POST' && (recurso === 'comentarios' || recurso === 'puntos'));",
          "if (exigeFilme && (typeof nome !== 'string' || !nome.startsWith('qa-postman-') || !Number.isInteger(id) || id < 1)) {",
          "    console.warn('Requisição ignorada porque o cadastro do filme de teste não foi confirmado.');",
          "    pm.execution.skipRequest();",
          "}"
        ]
      }
    }
